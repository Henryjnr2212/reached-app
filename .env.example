# Reached environment. Copy to .env (gitignored) and fill in. Never commit real values.

# --- Messaging -------------------------------------------------------------
# fake: messages are written to public.fake_messages (default, used by all tests)
# live: messages go to Africa's Talking / WhatsApp Cloud API
MESSAGING_MODE=fake
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
# Branded sender ID (e.g. REACHED). Leave empty to use the shared short code.
AFRICASTALKING_SENDER_ID=
# Use the sandbox API (https://api.sandbox.africastalking.com) when true.
AFRICASTALKING_SANDBOX=true
# Shared token appended to the inbound / delivery report callback URLs (?token=…)
AFRICASTALKING_CALLBACK_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret the database sends to the dispatch function (also set in private.settings 'dispatch_secret')
DISPATCH_SECRET=
# Auth "Send SMS" hook secret from the Supabase dashboard (v1,whsec_…)
SEND_SMS_HOOK_SECRET=
# Android SMS Retriever app hash so the OTP is read automatically
ANDROID_SMS_HASH=
# Expo push access token (optional; enhanced push security)
EXPO_ACCESS_TOKEN=
# Base URL for live location links sent to contacts
LIVE_BASE_URL=https://reached.app/l/

# --- Phase 2 / 3 -------------------------------------------------------------
GHANAPOST_MODE=fake
GHANAPOST_API_URL=
GHANAPOST_API_KEY=
# fake | live — payment provider for MTN MoMo / Telecel Cash / AT Money / card
PAYMENTS_MODE=fake
PAYMENTS_API_URL=
PAYMENTS_API_KEY=
PAYMENTS_WEBHOOK_SECRET=

# --- Mobile app (Expo, public) ---------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# demo: in-memory backend used by web previews and e2e tests; supabase: real backend
EXPO_PUBLIC_BACKEND=supabase
EXPO_PUBLIC_WEB_URL=https://reached.app
EXPO_PUBLIC_SUPPORT_WHATSAPP=+233000000000
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Web (Next.js, Vercel) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://reached.app
NEXT_PUBLIC_DPC_REGISTRATION_NUMBER=PENDING
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@reached.app
